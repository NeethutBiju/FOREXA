# FOREXA Environment Configuration Example
FOREXA_STORAGE=local               # local (DuckDB + Parquet) | gcp (BigQuery + GCS)
FOREXA_DEFAULT_ROLE=technical      # technical | authority (used only when Authorization Bearer token is omitted in local dev)

# Google Cloud Settings (Required only when FOREXA_STORAGE=gcp)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
FOREXA_GCS_BUCKET=forexa-kerala-data
FOREXA_BQ_DATASET=forexa_kerala
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
