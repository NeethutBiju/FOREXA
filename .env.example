# FOREXA Environment Configuration Example
FOREXA_STORAGE=local               # local (DuckDB + Parquet) | gcp (BigQuery + GCS)
FOREXA_DEFAULT_ROLE=technical      # technical | authority (used only when Authorization Bearer token is omitted in local dev)

# Google Cloud Settings (Required only when FOREXA_STORAGE=gcp)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
FOREXA_GCS_BUCKET=forexa-kerala-data
FOREXA_BQ_DATASET=forexa_kerala
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Optional Live Carrier SMS Gateway Keys (copy to .env for real SIM SMS)
# Option 1 (India - works for ANY 10-digit Indian mobile number):
# FAST2SMS_API_KEY=your_fast2sms_api_key_here
# Option 2 (Global - Twilio):
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# Option 3 (100% Free Live Email Alert to ANY Registered Email via Gmail App Password):
# SMTP_EMAIL=your_gmail@gmail.com
# SMTP_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
